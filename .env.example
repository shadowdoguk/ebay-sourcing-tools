# Copy to .env and fill in. Never commit .env - it is gitignored.
# eBay Partner app credentials: https://developer.ebay.com/my/keys

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Marketplace id used for every request header.
EBAY_MARKETPLACE_ID=EBAY_US

# production | sandbox
EBAY_ENVIRONMENT=production

# SQLite database location.
EBAY_SOURCING_DB=data/ebay_sourcing.db

# Space separated OAuth scopes.
EBAY_SCOPES=https://api.ebay.com/oauth/api_scope

# Client side request ceiling per minute.
EBAY_RATE_LIMIT_PER_MINUTE=60

# Per request timeout in seconds, and retries for transient failures.
EBAY_REQUEST_TIMEOUT=30
EBAY_MAX_RETRIES=4
